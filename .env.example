# ---------------------------------------------------------------------------
# Copy to .env at the repo root and adjust. Local defaults match
# infra/docker-compose.yml so the stack runs with no edits.
# ---------------------------------------------------------------------------

# --- Database (PostGIS + pgvector) ---
# Port 5434 avoids clashing with a local PostgreSQL that usually owns 5432.
DATABASE_URL=postgresql+psycopg://mining:mining@localhost:5434/mining_governance

# --- Infra host ports (read by infra/docker-compose.yml) ---
POSTGRES_PORT=5434
REDIS_PORT=6379

# --- Redis / background jobs ---
REDIS_URL=redis://localhost:6379/0

# --- Resend reminder delivery ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=MineGuard compliance
REMINDER_SEND_ENABLED=false

# --- API ---
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000
API_SECRET_KEY=change-me-in-production

# --- API authentication (Supabase JWT verification) ---
# "supabase" verifies Supabase Auth JWTs; "disabled" treats every request as a
# development administrator and must never be used in production.
AUTH_MODE=supabase
# Project URL, for asymmetric (JWKS) verification. Preferred.
SUPABASE_URL=
# Legacy shared HS256 secret, only for older projects (Project Settings -> API).
SUPABASE_JWT_SECRET=
# Role granted to the very first user to sign in; later unknown users are refused.
BOOTSTRAP_ROLE=admin
# --- Self-registration (optional) ---
# When true, Supabase-authenticated users who sign up through /register get a
# profile automatically with SELF_REGISTRATION_ROLE. Requires "Allow new users
# to sign up" enabled in Supabase -> Authentication -> Providers -> Email.
SELF_REGISTRATION_ENABLED=false
SELF_REGISTRATION_ROLE=inspector
# Where Supabase sends people after they accept an invite (must also be listed
# under Authentication -> URL Configuration -> Redirect URLs in the dashboard).
INVITE_REDIRECT_URL=http://localhost:3000/auth/callback

# --- Supabase (auth + document storage) ---
# Public values, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=mining-documents

# --- LLM providers (document extraction, compliance explanations) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000



